# Copy this file to ".env" in the same directory and fill in real values.
# The server refuses to start when any required variable is missing
# (see src/config/environments.ts). Never commit the real .env.

NODE_ENV=development

# Ports the server listens on (HTTPS is only used when CREDENTIALS_ENABLED=1)
HTTP_PORT=8088
HTTPS_PORT=8443

# TLS via certbot (0 = off; when 1, CREDENTIALS_PATH/CA/KEY/CERT are also required)
CREDENTIALS_ENABLED=0

# GitHub webhook for auto-updates (0 = off; when 1, WEBHOOK_SECRET is also required)
WEBHOOK_ENABLED=0

# GitHub OAuth app, used for sign-in / gists and for fetching tracer releases.
# Leaving these empty still lets the server run; GitHub API calls are then unauthenticated.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Code execution is fully local - Java and Python run in local
# subprocesses (javac/java and python3 must be on the PATH, or set
# JAVAC_BIN / JAVA_BIN / PYTHON_BIN to their full paths), C++ runs in a
# local Docker container, and JavaScript runs in the browser. No AWS
# account or credentials are used anywhere.

# AI coding assistant (optional): an OpenAI-compatible chat-completions
# endpoint used by POST /api/ai/assist. Example for Google Gemini:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=
# LLM_MODEL=
# Optional: per-call timeout in milliseconds (default 180000), and a
# fallback model that automatically takes over when the primary model
# stays overloaded (e.g. Gemini's lite variant of the same model):
# LLM_TIMEOUT_MS=
# LLM_MODEL_FALLBACK=
